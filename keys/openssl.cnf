[ req ]
default_bits        = 2048
default_keyfile     = privkey.pem
distinguished_name  = req_distinguished_name
req_extensions      = v3_req
cipher_list         = ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384

[ req_distinguished_name ]
countryName                     = Country Name (2 letter code)
countryName_default             = US
organizationName                = Organization Name (eg, company)
organizationName_default        = Nexis Financial Core Corp
commonName                      = Common Name (eg, YOUR name)
commonName_default              = api.nexis-core.finance

[ v3_req ]
basicConstraints = CA:FALSE
keyUsage = nonRepudiation, digitalSignature, keyEncipherment
subjectAltName = @alt_names

[ alt_names ]
DNS.1 = api.nexis-core.finance
DNS.2 = gateway.nexis-core.finance
DNS.3 = localhost
