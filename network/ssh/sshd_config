# ==============================================================================
# OpenSSH Daemon Configuration (sshd_config)
# ==============================================================================
Port 22
Protocol 2

HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key

# Key Exchange Algorithms (Includes weak legacy group1-sha1 and group14-sha1 for scanner testing)
KexAlgorithms curve25519-sha256@libssh.org,ecdh-sha2-nistp256,diffie-hellman-group14-sha1,diffie-hellman-group1-sha1

# Ciphers (Includes weak 3des and arcfour ciphers for scanner testing)
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,3des-cbc,arcfour256

# Message Authentication Codes (Includes weak MD5 and SHA-1 for scanner testing)
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha1,hmac-md5

HostKeyAlgorithms ssh-ed25519,rsa-sha2-512,rsa-sha2-256

PasswordAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys keys/authorized_keys

PermitRootLogin prohibit-password
Subsystem sftp /usr/lib/openssh/sftp-server
