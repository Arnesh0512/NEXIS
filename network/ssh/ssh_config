# ==============================================================================
# OpenSSH Client Configuration (ssh_config)
# ==============================================================================
Host *
    SendEnv LANG LC_*
    HashKnownHosts yes
    GSSAPIAuthentication no
    KexAlgorithms curve25519-sha256@libssh.org,diffie-hellman-group14-sha1
    Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,3des-cbc
    MACs hmac-sha2-512-etm@openssh.com,hmac-sha1
