# ==============================================================================
# OpenSSH User Client Configuration (.ssh/config)
# Nexis Core Platform Enterprise Testbed
# ==============================================================================
Host git.nexis-internal.finance
    HostName git.nexis-internal.finance
    User git
    Port 22
    IdentityFile ~/.ssh/id_rsa
    KexAlgorithms diffie-hellman-group14-sha1,curve25519-sha256@libssh.org
    Ciphers 3des-cbc,aes256-gcm@openssh.com
    MACs hmac-sha1,hmac-sha2-512-etm@openssh.com

Host backup-vault.internal
    HostName backup.nexis-core.internal
    Port 2222
    User backup
    IdentityFile ~/.ssh/id_ed25519
    KexAlgorithms diffie-hellman-group1-sha1
    Ciphers arcfour256
    MACs hmac-md5
